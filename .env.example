# Every variable is optional. No .env file is required; Mossnote reads the process environment.

# Must be a loopback address (127.0.0.1, ::1 or localhost). Anything else is refused unless
# MOSS_ALLOW_REMOTE=1, which prints a warning and is unsupported.
MOSS_HOST=127.0.0.1
# MOSS_ALLOW_REMOTE=1

# HTTP port.
MOSS_PORT=4317

# Data folder: every journal is one <name>.db file in it, side by side. Default:
# ~/Library/Application Support/Mossnote/ on macOS, $XDG_DATA_HOME/mossnote/ (default
# ~/.local/share/mossnote/) on Linux, %APPDATA%\Mossnote\ on Windows.
# MOSS_DATA_DIR=

# Open this journal (<name>.db: letters, digits, "-" and "_") at start, and make it from the
# Default template if it does not exist. Not needed to use several journals: leave it unset and
# Mossnote opens the one you used last and lists the others.
# MOSS_JOURNAL=journal

# Number of automatic snapshots to keep, per journal.
MOSS_BACKUP_KEEP=14

# 1 opens the browser on start, 0 does not.
MOSS_OPEN_BROWSER=1

# error, warn, info or debug. Logs never contain note text.
MOSS_LOG_LEVEL=info
