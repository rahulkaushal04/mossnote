# Every variable is optional. No .env file is required; Mossnote reads the process environment.

# Must be a loopback address (127.0.0.1, ::1 or localhost). Anything else is refused unless
# MOSS_ALLOW_REMOTE=1, which prints a warning and is unsupported.
MOSS_HOST=127.0.0.1
# MOSS_ALLOW_REMOTE=1

# HTTP port.
MOSS_PORT=4317

# Data folder. Default: ~/Library/Application Support/Mossnote/ on macOS,
# $XDG_DATA_HOME/mossnote/ (default ~/.local/share/mossnote/) on Linux, %APPDATA%\Mossnote\ on Windows.
# MOSS_DATA_DIR=

# File name stem of the journal (<name>.db): letters, digits, "-" and "_". A second playthrough
# uses another name.
MOSS_JOURNAL=journal

# Number of automatic snapshots to keep.
MOSS_BACKUP_KEEP=14

# 1 opens the browser on start, 0 does not.
MOSS_OPEN_BROWSER=1

# error, warn, info or debug. Logs never contain note text.
MOSS_LOG_LEVEL=info
