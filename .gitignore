# Dependencies
node_modules/
.npm-cache/
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build output (any workspace: packages/*/dist, out, ...)
dist/
out/
.tsbuild/
*.tsbuildinfo
.vite/
vite.config.*.timestamp-*

# Standalone program builds (npm run package:binary)
/build/
/release/
*.tgz

# Python wheel: the app is copied in by `npm run package:python`; none of this is source.
python/src/mossnote/_app/
python/LICENSE
python/build/
python/*.egg-info/
python/src/*.egg-info/
__pycache__/
*.pyc
.pytest_cache/

# Tests and coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Local data (dev runs, benchmarks) - can hold real notes and large SQLite files
.dev-data/
.bench-data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
!tests/**/*.sqlite
!packages/**/fixtures/**/*.sqlite

# Env and secrets (keep the example)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
*.provisionprofile

# Logs and reports
*.log
logs/
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.pid

# Lint caches
.eslintcache
.stylelintcache

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Local-only files (kept on this machine)
local_reference/
docs/assets/.video-tmp/
.claude/
CLAUDE.md
/SPEC.md
/SPEC-*.md
/CAPABILITY-MAP.md
/tasks/
/docs/research/
/docs/progress.md
