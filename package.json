{
  "name": "mossnote",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, spoiler-free personal journal.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "tsx scripts/start.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -b && vite build && tsup",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "build:e2e": "tsc -b && vite build --mode e2e && tsup",
    "check:network": "tsx scripts/check-no-network.ts",
    "db:studio": "drizzle-kit studio",
    "db:vacuum": "tsx --tsconfig tsconfig.server.json scripts/vacuum.ts"
  },
  "dependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@hono/node-server": "2.1.3",
    "@hono/zod-validator": "0.9.1",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tanstack/react-query": "5.104.1",
    "better-sqlite3": "13.0.3",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.3",
    "env-paths": "4.0.0",
    "hono": "4.13.13",
    "open": "11.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "tinykeys": "4.0.1",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
